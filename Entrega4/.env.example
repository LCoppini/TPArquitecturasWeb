# Copiar a .env y completar con valores reales. NUNCA versionar .env.
# Variables JWT para Entrega 2 (RS256).

# msvc-usuarios firma los tokens con esta clave privada.
# Pegar el PEM en una sola línea usando \n para los saltos.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREEMPLAZAR_POR_CLAVE_PRIVADA_RSA\n-----END PRIVATE KEY-----\n

# El gateway valida con la clave pública ubicada aquí (archivo montado o classpath:).
JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/ticketya_jwt_public.pem

# Emisor y audiencia del token; deben coincidir en msvc-usuarios y en el gateway.
JWT_ISSUER=ticketya
JWT_AUDIENCE=ticketya

# Duracion del token en segundos (900 = 15 minutos).
JWT_EXPIRATION_SECONDS=900
